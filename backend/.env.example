NODE_ENV=development

PORT=4000



DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require



CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174



JWT_ACCESS_SECRET=change-me-in-production

JWT_REFRESH_SECRET=change-me-in-production-too

JWT_ACCESS_TTL=15m

JWT_REFRESH_TTL_DAYS=30

COOKIE_SECURE=false



# Local file storage (default) or S3-compatible object storage

STORAGE_DRIVER=local

STORAGE_ROOT=./storage

PUBLIC_BASE_URL=http://127.0.0.1:4000



# S3 / R2 / MinIO (set STORAGE_DRIVER=s3)

STORAGE_ENDPOINT=

STORAGE_REGION=auto

STORAGE_BUCKET=

STORAGE_ACCESS_KEY=

STORAGE_SECRET_KEY=

STORAGE_FORCE_PATH_STYLE=false



UPLOAD_SIGNING_SECRET=change-me-upload-signing

UPLOAD_URL_EXPIRES_SECONDS=900

DOWNLOAD_URL_EXPIRES_SECONDS=900

MAX_AUDIO_FILE_SIZE_MB=80

MAX_VIDEO_FILE_SIZE_MB=500

MAX_IMAGE_FILE_SIZE_MB=15



REDIS_URL=redis://127.0.0.1:6379

WORKER_TEMP_DIR=
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_TARGET_CHANNELS=1
BULLMQ_JOB_ATTEMPTS=3
BULLMQ_BACKOFF_MS=5000
MEDIA_WORKER_CONCURRENCY=2

AI_LANGUAGE_DETECT_MODE=demo
LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.75
DEMO_LANGUAGE_DETECT_CODE=
DEMO_LANGUAGE_MIXED=false

# Seed platform admin: npm run db:seed-admin
SEED_ADMIN_EMAIL=admin@nyimba.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_FIRST_NAME=Platform
SEED_ADMIN_LAST_NAME=Admin
